{
  "mcpServers": {
    "godot-project": {
      "command": "C:/path/to/mcp-for-godot/.venv/Scripts/python.exe",
      "args": [
        "-m",
        "mcp_for_godot",
        "--project",
        "C:/path/to/my-godot-project",
        "--godot",
        "C:/path/to/Godot_v4.7.2-stable_win64_console.exe",
        "--allow-write",
        "--allow-run",
        "--allow-capture",
        "--allow-input",
        "--allow-script-write"
      ]
    }
  }
}
